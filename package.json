{
  "name": "sythix-unite",
  "version": "0.1.0",
  "private": true,
  "description": "SythiX Unite — Everything. Everyone. United.",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "gen": "node scripts/gen-migrations.mjs",
    "predev": "node scripts/gen-migrations.mjs && node scripts/ensure-dev-vars.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:api": "wrangler dev --port 8787",
    "build": "node scripts/gen-migrations.mjs && vite build",
    "preview": "pnpm run build && wrangler dev --port 8787",
    "deploy": "pnpm run build && wrangler deploy",
    "lint": "eslint .",
    "typecheck": "node scripts/gen-migrations.mjs && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "test": "node scripts/gen-migrations.mjs && vitest run",
    "test:e2e": "playwright test",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:migrate:local": "wrangler d1 migrations apply sythix-unite-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply sythix-unite-db --remote"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.0",
    "hono": "^4.10.0",
    "lucide-react": "^0.545.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.9.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260601.0",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.4.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.0",
    "vitest": "^4.0.0",
    "wrangler": "^4.40.0"
  },
  "pnpm": { "onlyBuiltDependencies": ["esbuild", "workerd", "sharp"] }
}
