{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["@cloudflare/workers-types", "node"],
    "baseUrl": ".",
    "paths": { "@shared/*": ["src/shared/*"], "@worker/*": ["src/worker/*"] }
  },
  "include": ["src/worker", "src/shared", "tests", "vitest.config.ts", "vite.config.ts", "playwright.config.ts", "e2e"]
}
