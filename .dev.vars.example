# Copy to .dev.vars for local development. NEVER commit .dev.vars.
# Production values are set with `wrangler secret put <NAME> --env production`.

# Cloudflare Turnstile. These are Cloudflare's official always-pass TEST keys.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Comma-separated emails that are granted the platform_owner role once verified.
PLATFORM_OWNER_EMAILS=owner@example.com

# Optional: transactional email via Resend's HTTP API. When unset, emails are
# written to the dev outbox (visible at /dev/outbox in development only).
# RESEND_API_KEY=
# EMAIL_FROM="SythiX Studio <no-reply@example.com>"

# Optional: Microsoft identity platform app for Minecraft Java account linking.
# MS_CLIENT_ID=
# MS_CLIENT_SECRET=
