// SythiX Unite — one Worker serves the SPA (static assets) and the API.
// D1 and R2 are declared by name only: `wrangler deploy` creates them on the
// first deploy, and the Worker applies its own D1 migrations on first use.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sythix-unite",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  "vars": { "APP_ENV": "production" },
  "d1_databases": [{ "binding": "DB", "database_name": "sythix-unite-db", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "sythix-unite-media" }],
  "durable_objects": { "bindings": [{ "name": "REALTIME", "class_name": "RealtimeRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RealtimeRoom"] }],
  "triggers": { "crons": ["17 3 * * *"] }
}
